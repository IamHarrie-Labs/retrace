# Tatum — https://dashboard.tatum.io (free key). Used for every Sui Mainnet read and for the wallet RPC proxy.
TATUM_API_KEY=
# TATUM_SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io

# Walrus Memory — create an account + delegate key at https://memory.walrus.xyz
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Retrace Move package on Sui Mainnet (after `sui client publish` in ./move)
NEXT_PUBLIC_RETRACE_PACKAGE_ID=
# Shared Registry object created by the package's init (serial hash -> passport)
NEXT_PUBLIC_RETRACE_REGISTRY_ID=

# Secret pepper for keyed serial hashes (HMAC-SHA256). Keep it stable: changing it breaks duplicate detection.
SERIAL_PEPPER=

# Random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# Durable exact event index and sign-in replay protection. Mount a persistent volume in production.
RETRACE_DATA_DIR=.data
# Public website origin, e.g. https://retrace.example.com (optional for localhost).
# APP_ORIGIN=http://localhost:3000

# Checkpoint just before the Move package was published (event scans start here)
RETRACE_PACKAGE_CHECKPOINT=342751141

# Optional: "Sign in with Google" (zkLogin) and gas sponsorship via Enoki - https://portal.enoki.mystenlabs.com
# Public key + Google OAuth client ID enable Google sign-in. The private key enables sponsored mint/transfer
# (restricted server-side to Retrace's own two entry functions).
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ENOKI_PRIVATE_KEY=

# Optional: passport shown to judges/visitors as the live read-only example
NEXT_PUBLIC_DEMO_PASSPORT_ID=
